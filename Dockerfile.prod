FROM php:8.2-apache

# Extensión para conectarse a MySQL con PDO
RUN docker-php-ext-install pdo_mysql

# Configuración de PHP para producción (errores ocultos, solo al log)
COPY docker/php.prod.ini /usr/local/etc/php/conf.d/tornea.ini

# No mostrar la versión de Apache en encabezados ni páginas de error
RUN printf 'ServerTokens Prod\nServerSignature Off\n' > /etc/apache2/conf-enabled/zz-tornea.conf

# El código usa rutas absolutas /tornea/..., así que la app vive en /var/www/html/tornea
COPY . /var/www/html/tornea

# La raíz del servidor redirige a la app
RUN printf '<?php header("Location: /tornea/index.php");\n' > /var/www/html/index.php

EXPOSE 80
