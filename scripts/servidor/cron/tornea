# Tareas programadas de Tornea - Terobyte
# Se instala copiándolo a /etc/cron.d/tornea (ver scripts/servidor/README.md).
# Corren como root porque escriben en /var/backups y /var/log y manejan Docker.
# Si el repo no está en /home/terobyte/tornea, cambiar las rutas.
#
# minuto hora día mes día-semana usuario comando

# Respaldo Tornea - todos los días a las 02:00
0 2 * * * root /home/terobyte/tornea/scripts/servidor/backup_tornea.sh

# Monitoreo Tornea - cada 30 minutos
*/30 * * * * root /home/terobyte/tornea/scripts/servidor/monitoreo_tornea.sh

# Informe de la base de datos - todos los días a las 06:00
0 6 * * * root /home/terobyte/tornea/scripts/servidor/monitoreo_bd.sh --informe

# Antivirus - domingos a las 03:00 (después del respaldo)
0 3 * * 0 root /home/terobyte/tornea/scripts/servidor/seguridad_tornea.sh --escaneo

# Al prender el servidor, vuelve a bloquear las IPs de la lista
# (se espera un minuto a que Docker cree la cadena DOCKER-USER)
@reboot root sleep 60 && /home/terobyte/tornea/scripts/servidor/seguridad_tornea.sh --reaplicar
